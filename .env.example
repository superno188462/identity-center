APP_ENV=development
HOST=127.0.0.1
PORT=8002
DATABASE_URL=postgresql+asyncpg://identity_user:change-me@127.0.0.1:5432/identity_center
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
AUTH_ALLOW_REGISTRATION=true
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Leave empty for localhost. Use a shared parent domain only for same-site subdomains.
AUTH_COOKIE_DOMAIN=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
