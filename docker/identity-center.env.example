APP_ENV=production
HOST=0.0.0.0
PORT=8002
# Use the PostgreSQL address reachable from this container. Do not use localhost
# unless PostgreSQL runs in this same container.
DATABASE_URL=postgresql+asyncpg://identity_user:REPLACE_WITH_STRONG_PASSWORD@host.docker.internal:5432/identity_center
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
AUTH_ALLOW_REGISTRATION=true
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
# Exact browser-visible frontend origins; include scheme and port, no trailing slash.
CORS_ALLOW_ORIGINS=https://YOUR_FRONTEND_DOMAIN
